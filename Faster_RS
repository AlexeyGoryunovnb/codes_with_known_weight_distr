%                 B = zeros(1,length(B),'uint8');
%                 BB=prodGF(BB,inv_d);
%                 for j = 1:length(ii)
%                     B(ii(j))=BB(j);
%                 end

                for j = 1:length(B)
                    if B(j)
                        B(j) = prodGF(B(j), inv_d);
                    end
                end




                m = 1;
            else
                m = m + 1;
            end
        else
            m = m + 1;
        end
    end
end

function Y = ForneyGF(I, LAM, S)
    global ExpGF n
    
    Omega = ConvGF(LAM, S, length(LAM), length(S));
    Omega = Omega(1:length(S)); 
    
    Y = zeros(1, length(I), 'uint16');
    
    for j = 1:length(I)
        
        Omega_val = 0;
        for k = 1:length(Omega)
            if Omega(k)
                if k == 1
                    term = Omega(k);
                else
                    term = prodGF(Omega(k), ExpGF(mod((k-1)*double(I(j)), n) + 1));
                end
                Omega_val = bitxor(Omega_val, term);
            end
        end
        
        LAM_prime = 0;
        for k = 2:2:length(LAM)
            if LAM(k)
                if k == 2
                    term = LAM(k);
                else
                    term = prodGF(LAM(k), ExpGF(mod((k-2)*double(I(j)), n) + 1));
                end
                LAM_prime = bitxor(LAM_prime, term);
            end
        end
        if ~LAM_prime
            print('5')
            Y = 0;
            return
        end
        if double(Omega_val)*double(inverGF(LAM_prime))
            Y(j) = prodGF(Omega_val, inverGF(LAM_prime));
        else
            print('6')
            Y = 0;
            return
        end
    end
end

function I = ChienGF(L,i)
    global ExpGF n
    A = zeros(1,n,'uint16');
    k = 2;
    nn = 2;
    vi = 1;
    for j = L(2:end)
        if j
            vi(nn)=k;
            nn=nn+1;
        end
        k=k+1;
    end
    Y = ExpGF(1:i+1);
    for j = 1:n
        for k = vi
            A(j)=bitxor(A(j),prodGF(Y(k),L(k)));
            if k~=1 && j~=n
                Y(k)=prodGF(Y(k),ExpGF(k));
            end
        end
    end
    A = A==0;
    if sum(A)~=i
        I=0;
        return
    end
    t = 1;
    I = zeros(1,i,'uint16');
    for j = 1:n
        if A(j)
            I(t)=j;
            t = t+1;
            if t>i
                break
            end
        end
    end
end
