function c = RScode(a,g,n)
    c = uint16(zeros(1,n));%16<-------
    for i = 1:length(a)
        if a(i)~=0
            c(i:i+length(g)-1) = bitxor(c(i:i+length(g)-1),prodGF(g,a(i)));
        end
    end
end

function C = prodGF(A,B)
    global n ExpGF LogGF
    C = ExpGF(mod(LogGF(A)+LogGF(B),n)+1);
end

function C = inverGF(A)
    global n ExpGF LogGF
    C = ExpGF(mod(uint16(n)-LogGF(A),n)+1);%16<-------
end



function flag = RSdecode(v,c,t)
    S = GornerGF(v,t);
    if sum(S) ~= 0
        [LAM, i] = BerMesGF(S);
        if ~LAM
            flag = 2;
            return
        end
        
        I = ChienGF(LAM,i);
        if I==0
            flag = 2;
            return
        end
        Y = ForneyGF(I,LAM,S);
        if ~Y
            flag = 2;
            return
        end
        for j = 1:i
            v(I(j)) = bitxor(v(I(j)),Y(j));
        end
    end
    if c==v
        flag = 1;
    else
        flag = 0;
    end
end



function C = ConvGF(A,B,la,lb)
    C = zeros(1,la+lb-1,"uint16");
    for i = 1:la
        for j =1:lb
            if double(A(i))*double(B(j))
                C(i+j-1)=bitxor(C(i+j-1),prodGF(A(i),B(j)));
            end
        end
    end
end

function S = GornerGF(V,t)
    global n ExpGF
    S = ones(1,2*t,'uint16')*V(1);
    for i = 2:n
        nn = 1;
        ii = 0;
        SS = 0;
        EE = 0;
        for j = 1:2*t
            if S(j)
                ii(nn)=j;
                SS(nn)=S(j);
                EE(nn)=ExpGF(j+1);
                nn = nn+1;
            end
        end
        S=ones(1,2*t,'uint16')*V(i);
        if SS
            SS = prodGF(SS,EE);
            for j = 1:length(ii)
                S(ii(j))=bitxor(S(ii(j)),SS(j));
            end
        end
    end
end


function [L, v] = BerMesGF(S)
    n = length(S);
    L = 1;
    B = 1;
    v = 0;
    m = 1;
    
    for r = 1:n
        d = 0;
        for j = 0:v
            if j+1 <= length(L) && r-j >= 1 && r-j <= length(S)
                if double(L(j+1))*double(S(r-j))
                    d = bitxor(d, prodGF(L(j+1), S(r-j)));
                end
            end
        end
        
        if d
            T = L;
            L = [L, zeros(1, m+length(B)-length(L))];

            for j = 1:length(B)
                if B(j) ~= 0
                    idx = j + m;
                    if idx <= length(L)
                        L(idx) = bitxor(L(idx), prodGF(d, B(j)));
                    else
                        L(idx) = prodGF(d, B(j));
                    end
                end
            end
            
            if 2*v <= r-1
                v = r - v;
                if v>n/2
                    L = 0;
                    v = 0;
                    return
                end
                B = T;
                inv_d = inverGF(d);


